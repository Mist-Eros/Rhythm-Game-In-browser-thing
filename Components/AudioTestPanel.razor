@using RiffGame.Interop
@using RiffGame.Songs
@using RiffGame.Game
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject HttpClient Http

<h2>Audio test</h2>

<p class="text-dim">
    Click any button first — browsers block audio until a user gesture.
</p>

<div class="row">
    @foreach (var instrument in Instruments)
    {
        <button class="btn" style="color:@InstrumentPalette.For(instrument)" @onclick="() => PlayNoteAsync(instrument)">
            @instrument
        </button>
    }
</div>

<div class="row">
    <button class="btn btn-accent" @onclick="StartMetronomeAsync">Start metronome</button>
    <button class="btn" @onclick="StopAsync">Stop</button>
    <span class="text-dim">Transport: @_transportTime.ToString("F2") s</span>
</div>

<h2 class="mt-4">Song Player</h2>

<div class="row">
    <button class="btn btn-accent" @onclick="LoadAndPlaySampleAsync">Load sample &amp; play</button>
    <button class="btn" @onclick="StopSongAsync">Stop</button>
    <span class="text-dim">@_songInfo</span>
</div>

@code {
    private static readonly string[] Instruments =
        ["kick", "snare", "hihat", "bass", "guitar", "piano", "musicbox"];

    private const double DefaultNoteDurationSec = 0.5;
    private const double MetronomeBpm = 120;
    private const int MetronomeBeats = 8;

    private AudioInterop _audio = default!;
    private System.Timers.Timer? _pollTimer;
    private CancellationTokenSource? _metronomeCts;
    private double _transportTime;
    private SongPlayer? _songPlayer;
    private string _songInfo = "";

    protected override void OnInitialized()
    {
        _audio = new AudioInterop(JS, Navigation);
        _pollTimer = new System.Timers.Timer(100) { AutoReset = true };
        _pollTimer.Elapsed += async (_, _) => await PollTransportAsync();
        _pollTimer.Start();
    }

    private async Task PlayNoteAsync(string instrument)
    {
        await _audio.InitAsync();
        await _audio.PlayInstrumentAsync(instrument, "C4", DefaultNoteDurationSec);
    }

    private async Task StartMetronomeAsync()
    {
        await _audio.InitAsync();
        await _audio.SetBpmAsync(MetronomeBpm);
        await _audio.ClearScheduledAsync();
        await _audio.SeekTransportAsync(0);

        var beatSec = 60.0 / MetronomeBpm;
        for (var i = 0; i < MetronomeBeats; i++)
        {
            await _audio.PlayInstrumentAsync("kick", "C1", 0.1, i * beatSec);
        }

        await _audio.StartTransportAsync();

        _metronomeCts?.Cancel();
        _metronomeCts = new CancellationTokenSource();
        _ = StopMetronomeAfterAsync(MetronomeBeats * beatSec, _metronomeCts.Token);
    }

    private async Task StopMetronomeAfterAsync(double delaySec, CancellationToken token)
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(delaySec + 0.3), token);
            await InvokeAsync(StopTransportAsync);
        }
        catch (TaskCanceledException)
        {
            // Stop button already stopped the transport.
        }
    }

    private async Task StopAsync()
    {
        _metronomeCts?.Cancel();
        await _audio.StopTransportAsync();
    }

    private async Task PollTransportAsync()
    {
        try
        {
            await InvokeAsync(async () =>
            {
                _transportTime = await _audio.GetTransportTimeSecAsync();
                StateHasChanged();
            });
        }
        catch (JSException)
        {
            // Tone/module not ready yet; ignore until next tick.
        }
    }

    private async Task StopTransportAsync()
    {
        await _audio.StopTransportAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadAndPlaySampleAsync()
    {
        try
        {
            await _audio.InitAsync();
            var song = await SongSerializer.LoadFromUrlAsync(Http, "songs/sample.json");
            _songPlayer = new SongPlayer(_audio, song);

            var noteCount = song.Tracks.Sum(track => track.Notes.Count);
            _songInfo = $"\"{song.Title}\" — {song.Bpm} BPM — {noteCount} notes";

            await _songPlayer.StartAsync();
        }
        catch (Exception ex)
        {
            _songInfo = $"Error: {ex.Message}";
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task StopSongAsync()
    {
        if (_songPlayer is not null)
        {
            await _songPlayer.StopAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        _metronomeCts?.Cancel();
        _metronomeCts?.Dispose();
        _pollTimer?.Dispose();
        await _audio.DisposeAsync();
    }
}
