@using RiffGame.Game
@using RiffGame.Interop
@using RiffGame.Songs
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation

<div class="piano-roll" @ref="_root">
    <div class="piano-roll-corner" aria-hidden="true"></div>
    <div class="piano-roll-ruler">
        <canvas></canvas>
    </div>
    <div class="piano-roll-keys">
        <canvas></canvas>
    </div>
    <div class="piano-roll-scroll">
        <div class="piano-roll-content">
            <canvas class="piano-roll-grid-canvas"></canvas>
        </div>
    </div>
</div>

@code {
    [Parameter] public string Instrument { get; set; } = InstrumentNames.Piano;
    [Parameter] public int SubdivisionsPerBeat { get; set; } = 4;
    [Parameter] public double LengthBeats { get; set; } = 60;
    [Parameter] public int BeatsPerBar { get; set; } = 4;
    [Parameter] public double TimeZoom { get; set; } = 1.0;
    [Parameter] public double PitchZoom { get; set; } = 1.0;
    [Parameter] public double PlayheadBeat { get; set; }
    [Parameter] public int Revision { get; set; }
    [Parameter] public bool Debug { get; set; }
    [Parameter] public IReadOnlyList<PianoRollNote> Notes { get; set; } = [];

    [Parameter] public EventCallback<ZoomChange> OnZoomChanged { get; set; }
    [Parameter] public EventCallback<NotePlacement> OnNotePlaced { get; set; }
    [Parameter] public EventCallback<NoteMove> OnNoteMoved { get; set; }
    [Parameter] public EventCallback<int> OnNoteDeleted { get; set; }
    [Parameter] public EventCallback<string[]> OnSelectionChanged { get; set; }
    [Parameter] public EventCallback<string> OnNoteToggled { get; set; }
    [Parameter] public EventCallback OnSelectAll { get; set; }
    [Parameter] public EventCallback OnSelectionCleared { get; set; }
    [Parameter] public EventCallback OnSelectionDragStarted { get; set; }
    [Parameter] public EventCallback<SelectionDelta> OnSelectionDragged { get; set; }
    [Parameter] public EventCallback OnSelectionDragEnded { get; set; }
    [Parameter] public EventCallback<SelectionDelta> OnNudged { get; set; }
    [Parameter] public EventCallback OnUndo { get; set; }
    [Parameter] public EventCallback OnRedo { get; set; }
    [Parameter] public EventCallback OnCopy { get; set; }
    [Parameter] public EventCallback OnPaste { get; set; }
    [Parameter] public EventCallback OnCut { get; set; }
    [Parameter] public EventCallback<NoteResize> OnNoteResized { get; set; }
    [Parameter] public EventCallback OnNoteResizeEnded { get; set; }
    [Parameter] public EventCallback<int> OnSelectionResizeSteps { get; set; }

    private ElementReference _root;
    private PianoRollInterop _interop = default!;
    private DotNetObjectReference<PianoRollCallbacks>? _callbacksRef;
    private bool _initialized;
    private string _configKey = "";
    private double _lastPlayhead = double.NaN;

    protected override void OnInitialized()
    {
        _interop = new PianoRollInterop(JS, Navigation);
        _callbacksRef = DotNetObjectReference.Create(new PianoRollCallbacks(new PianoRollHandlers
        {
            ZoomStep = HandleZoomStep,
            ZoomReset = HandleZoomReset,
            PlaceNote = (beat, midi) => OnNotePlaced.InvokeAsync(new NotePlacement(beat, midi)),
            MoveNote = (index, beat, midi) => OnNoteMoved.InvokeAsync(new NoteMove(index, beat, midi)),
            DeleteNote = index => OnNoteDeleted.InvokeAsync(index),
            SelectNotes = ids => OnSelectionChanged.InvokeAsync(ids),
            ToggleNote = id => OnNoteToggled.InvokeAsync(id),
            SelectAll = () => OnSelectAll.InvokeAsync(),
            ClearSelection = () => OnSelectionCleared.InvokeAsync(),
            SelectionDragStart = () => OnSelectionDragStarted.InvokeAsync(),
            SelectionDragUpdate = (beatSteps, rowSteps) =>
                OnSelectionDragged.InvokeAsync(new SelectionDelta(beatSteps, rowSteps)),
            SelectionDragEnd = () => OnSelectionDragEnded.InvokeAsync(),
            Nudge = (beatSteps, rowSteps) =>
                OnNudged.InvokeAsync(new SelectionDelta(beatSteps, rowSteps)),
            Undo = () => OnUndo.InvokeAsync(),
            Redo = () => OnRedo.InvokeAsync(),
            Copy = () => OnCopy.InvokeAsync(),
            Paste = () => OnPaste.InvokeAsync(),
            Cut = () => OnCut.InvokeAsync(),
            ResizeNote = (index, durationBeats) =>
                OnNoteResized.InvokeAsync(new NoteResize(index, durationBeats)),
            ResizeEnd = () => OnNoteResizeEnded.InvokeAsync(),
            ResizeSelected = steps => OnSelectionResizeSteps.InvokeAsync(steps),
        }));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var key = BuildConfigKey();

        if (!_initialized)
        {
            await _interop.InitAsync(_root, BuildConfig(), _callbacksRef!);
            _initialized = true;
            _configKey = key;
            _lastPlayhead = PlayheadBeat;
        }
        else if (key != _configKey)
        {
            await _interop.UpdateAsync(BuildConfig());
            _configKey = key;
        }

        if (_initialized && Math.Abs(PlayheadBeat - _lastPlayhead) > 1e-6)
        {
            await _interop.SetPlayheadAsync(PlayheadBeat);
            _lastPlayhead = PlayheadBeat;
        }
    }

    private string BuildConfigKey() =>
        $"{Instrument}|{SubdivisionsPerBeat}|{LengthBeats}|{BeatsPerBar}|{TimeZoom}|{PitchZoom}|{Revision}|{Debug}";

    private PianoRollConfig BuildConfig()
    {
        return new PianoRollConfig(
            InstrumentLayout.PitchMinMidi,
            InstrumentLayout.PitchMaxMidi,
            LengthBeats,
            BeatsPerBar,
            SubdivisionsPerBeat,
            TimeZoom,
            PitchZoom,
            PianoRollMetrics.BasePixelsPerBeat,
            PianoRollMetrics.BasePixelsPerSemitone,
            PlayheadBeat,
            Notes,
            Debug);
    }

    private async Task HandleZoomStep(string axis, int direction)
    {
        var time = TimeZoom;
        var pitch = PitchZoom;

        if (axis is "time" or "both")
        {
            time = ZoomLevels.StepBy(time, direction);
        }
        if (axis is "pitch" or "both")
        {
            pitch = ZoomLevels.StepBy(pitch, direction);
        }

        await OnZoomChanged.InvokeAsync(new ZoomChange(time, pitch));
    }

    private Task HandleZoomReset() => OnZoomChanged.InvokeAsync(new ZoomChange(1.0, 1.0));

    public async ValueTask DisposeAsync()
    {
        await _interop.DisposeAsync();
        _callbacksRef?.Dispose();
    }
}
