@using RiffGame.Services
@inject LibraryAuth Auth

@if (Visible)
{
    <div class="modal-backdrop" @onclick="Cancel">
        <div class="modal" @onclick="Noop" @onclick:stopPropagation="true">
            <h3 class="modal-title">Library access</h3>
            <p class="modal-text">Enter the password to modify the song library.</p>
            <input @ref="_input"
                   class="modal-input @(_error ? "error" : "") @(_success ? "success" : "") @(_shake ? "shake" : "")"
                   type="password"
                   placeholder="Password"
                   autocomplete="off"
                   value="@_value"
                   @oninput="OnInput"
                   @onkeydown="OnKeyDown" />
            @if (_error)
            {
                <div class="modal-error">Wrong password — try again.</div>
            }
            <div class="modal-actions">
                <button class="btn btn-accent" @onclick="Submit">Unlock</button>
                <button class="btn" @onclick="Cancel">Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback OnUnlocked { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private ElementReference _input;
    private string _value = "";
    private bool _error;
    private bool _success;
    private bool _shake;
    private bool _wasVisible;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Visible && !_wasVisible)
        {
            _value = "";
            _error = false;
            _success = false;
            _shake = false;
            await _input.FocusAsync();
        }
        _wasVisible = Visible;
    }

    private void Noop()
    {
    }

    private void OnInput(ChangeEventArgs e)
    {
        _value = e.Value?.ToString() ?? "";
        _error = false;
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Submit();
        }
        else if (e.Key == "Escape")
        {
            await Cancel();
        }
    }

    private async Task Submit()
    {
        if (_success)
        {
            return;
        }

        if (Auth.TryUnlock(_value))
        {
            _error = false;
            _success = true; // green flash
            StateHasChanged();
            await Task.Delay(180);
            await OnUnlocked.InvokeAsync();
            return;
        }

        // Wrong password: red border + shake, clear, refocus. No lockout.
        _error = true;
        _value = "";
        _shake = true;
        StateHasChanged();
        await _input.FocusAsync();
        _ = ResetShakeAsync();
    }

    private async Task ResetShakeAsync()
    {
        await Task.Delay(420);
        _shake = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task Cancel()
    {
        _value = "";
        _error = false;
        _success = false;
        _shake = false;
        await OnCancel.InvokeAsync();
    }
}
