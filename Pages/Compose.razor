@page "/compose"
@using Microsoft.AspNetCore.Components.Forms
@using RiffGame.Components
@using RiffGame.Game
@using RiffGame.Interop
@using RiffGame.Songs
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Compose · RiffGame</PageTitle>

<div class="compose">
    <div class="transport">
        <button class="btn btn-accent" @onclick="PlayAsync">▶ Play</button>
        <button class="btn" @onclick="PauseAsync">❚❚ Pause</button>
        <button class="btn" @onclick="StopAsync">■ Stop</button>

        <span class="readout">@Format(CurrentSeconds) / @Format(_state.LengthSeconds)</span>

        <label for="bpm">BPM</label>
        <input id="bpm" type="number" min="20" max="300" @bind="_state.Bpm" />

        <label for="snap">Snap</label>
        <select id="snap" @bind="_state.SubdivisionsPerBeat">
            @foreach (var option in SnapOptions.All)
            {
                <option value="@option.Subdivisions">@option.Label</option>
            }
        </select>

        <button class="btn" @onclick="SaveAsync">Save</button>
        <label class="btn">
            Load
            <InputFile OnChange="LoadAsync" accept=".json" style="display:none" />
        </label>

        <button class="btn" @onclick="CopySelection" title="Copy selection (Ctrl+C)">Copy</button>
        <button class="btn" @onclick="PasteClipboard" title="Paste staircase (Ctrl+V)">Paste</button>
        <button class="btn" @onclick="CutSelection" title="Cut selection (Ctrl+X)">Cut</button>
        <button class="btn" @onclick="Undo" title="Undo (Ctrl+Z)">Undo</button>
        <button class="btn" @onclick="Redo" title="Redo (Ctrl+Y)">Redo</button>

        @if (!string.IsNullOrEmpty(_status))
        {
            <span class="status-msg">@_status</span>
        }

        <span class="spacer"></span>

        <div class="zoom-controls">
            <div class="zoom-row">
                <span class="zoom-label">TIME</span>
                <button class="btn btn-mini" @onclick="() => AdjustTimeZoom(-1)">−</button>
                <span class="zoom-value">@_state.TimeZoom.ToString("0.00")x</span>
                <button class="btn btn-mini" @onclick="() => AdjustTimeZoom(1)">+</button>
            </div>
            <div class="zoom-row">
                <span class="zoom-label">PITCH</span>
                <button class="btn btn-mini" @onclick="() => AdjustPitchZoom(-1)">−</button>
                <span class="zoom-value">@_state.PitchZoom.ToString("0.00")x</span>
                <button class="btn btn-mini" @onclick="() => AdjustPitchZoom(1)">+</button>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="compose-error">@_error</div>
    }

    <div class="editor-main">
        <aside class="sidebar">
            <h2>Instruments</h2>
            <ul class="instrument-list">
                @foreach (var instrument in InstrumentNames.All)
                {
                    var color = InstrumentPalette.For(instrument);
                    var selected = _state.SelectedInstrument == instrument;
                    var noteCount = _state.WorkingSong.Tracks
                        .First(t => t.Instrument == instrument).Notes.Count;
                    <li class="instrument-item @(selected ? "selected" : "")"
                        style="color:@color"
                        @onclick="() => SelectInstrument(instrument)">
                        <span class="instrument-dot"></span>
                        <span class="instrument-name">@instrument</span>
                        <span class="instrument-mute">@noteCount</span>
                    </li>
                }
            </ul>
        </aside>

        <PianoRoll Instrument="_state.SelectedInstrument"
                   SubdivisionsPerBeat="_state.SubdivisionsPerBeat"
                   LengthBeats="_state.LengthBeats"
                   TimeZoom="_state.TimeZoom"
                   PitchZoom="_state.PitchZoom"
                   PlayheadBeat="_state.CurrentBeat"
                   Revision="_revision"
                   Debug="DebugOverlay"
                   Notes="AllNotes()"
                   OnZoomChanged="ApplyZoomChange"
                   OnNotePlaced="PlaceNote"
                   OnNoteMoved="MoveNote"
                   OnNoteDeleted="DeleteNote"
                   OnSelectionChanged="SelectNotes"
                   OnNoteToggled="ToggleNoteSelection"
                   OnSelectAll="SelectAllNotes"
                   OnSelectionCleared="ClearSelection"
                   OnSelectionDragStarted="BeginSelectionDrag"
                   OnSelectionDragged="UpdateSelectionDrag"
                   OnSelectionDragEnded="EndSelectionDrag"
                   OnNudged="NudgeSelection"
                   OnUndo="Undo"
                   OnRedo="Redo"
                   OnCopy="CopySelection"
                   OnPaste="PasteClipboard"
                   OnCut="CutSelection"
                   OnNoteResized="ResizeNote"
                   OnNoteResizeEnded="ResizeNoteEnd"
                   OnSelectionResizeSteps="ResizeSelectedNote"
                   OnDeleteSelected="DeleteSelectedNotes"
                   OnTogglePlay="TogglePlay"
                   OnAuditionStarted="AuditionStart"
                   OnAuditionStopped="AuditionStop" />
    </div>
</div>

@code {
    private readonly ComposeState _state = new();
    private AudioInterop _audio = default!;
    private DownloadInterop _downloader = default!;
    private SongPlayer? _player;
    private System.Timers.Timer? _playTimer;
    private int _revision;
    private string _error = "";
    private readonly Dictionary<Guid, (double Beat, int Midi)> _dragOriginals = new();

    private const int UndoLimit = 100;
    private readonly List<Song> _undo = [];
    private readonly List<Song> _redo = [];
    private readonly List<Note> _clipboard = [];
    private double _clipboardRefBeat;
    private int _pasteCount;
    private string _status = "";
    private bool _dragSnapshotTaken;
    private bool _resizeSnapshotTaken;

    // Coordinate debug overlay: set true to draw a crosshair + target cell.
    private bool DebugOverlay { get; set; }

    private double CurrentSeconds => TimingService.BeatsToSeconds(_state.CurrentBeat, _state.Bpm);

    protected override void OnInitialized()
    {
        _audio = new AudioInterop(JS, Navigation);
        _downloader = new DownloadInterop(JS, Navigation);
        _playTimer = new System.Timers.Timer(33) { AutoReset = true };
        _playTimer.Elapsed += async (_, _) => await PollAsync();
    }

    private void SelectInstrument(string instrument)
    {
        if (_state.SelectedInstrument == instrument)
        {
            return;
        }
        _state.SelectedInstrument = instrument;
        // Selection is per-track, so it cannot survive an instrument change.
        _state.SelectedNoteIds.Clear();
        _revision++;
    }

    /// <summary>
    /// Builds the render list for the piano roll. Every track is treated identically:
    /// notes are placed on their real pitch row, and only the color and the selected
    /// flag differ. Unselected tracks render as ghosts. There is no instrument-type
    /// branching anywhere in this path.
    /// </summary>
    private IReadOnlyList<PianoRollNote> AllNotes()
    {
        var result = new List<PianoRollNote>();

        foreach (var track in _state.WorkingSong.Tracks)
        {
            var color = InstrumentPalette.For(track.Instrument);
            var selected = track.Instrument == _state.SelectedInstrument;

            for (var i = 0; i < track.Notes.Count; i++)
            {
                var note = track.Notes[i];
                var midi = NormalizeMidi(PitchMath.TryNameToMidi(note.Pitch, out var m) ? m : 60);
                var chosen = selected && _state.SelectedNoteIds.Contains(note.Id);
                result.Add(new PianoRollNote(
                    note.Beat, midi, note.Duration, color, selected, i, note.Id.ToString(), chosen));
            }
        }

        return result;
    }

    private void PlaceNote(NotePlacement placement)
    {
        var track = _state.CurrentTrack;

        // Only an exact duplicate on this track is rejected. Different pitches at the
        // same beat (chords) and the same pitch on a different track are both allowed.
        if (HasExactDuplicate(track, ignoreIndex: -1, placement.Beat, placement.Midi))
        {
            return;
        }

        PushUndo();
        track.Notes.Add(new Note
        {
            Beat = placement.Beat,
            Pitch = PitchMath.MidiToName(placement.Midi),
            Velocity = 0.8,
            Duration = _state.SnapBeats,
        });
        _revision++;
    }

    private void MoveNote(NoteMove move)
    {
        var track = _state.CurrentTrack;
        if (move.Index < 0 || move.Index >= track.Notes.Count)
        {
            return;
        }

        // Refuse to move onto an exact duplicate; a different pitch at the same beat
        // (chord) is fine, so the note can be stacked.
        if (HasExactDuplicate(track, move.Index, move.Beat, move.Midi))
        {
            return;
        }

        var note = track.Notes[move.Index];
        track.Notes[move.Index] = note with
        {
            Beat = move.Beat,
            Pitch = PitchMath.MidiToName(move.Midi),
        };
        _revision++;
    }

    /// <summary>Clamps a MIDI value into the piano roll's shared visible range.</summary>
    private static int NormalizeMidi(int midi) =>
        Math.Clamp(midi, InstrumentLayout.PitchMinMidi, InstrumentLayout.PitchMaxMidi);

    /// <summary>
    /// True only if another note on this track sits at the exact same (Beat, Pitch).
    /// Same beat + different pitch (a chord) is NOT a duplicate and is allowed.
    /// </summary>
    private static bool HasExactDuplicate(Track track, int ignoreIndex, double beat, int midi)
    {
        for (var i = 0; i < track.Notes.Count; i++)
        {
            if (i == ignoreIndex)
            {
                continue;
            }
            var note = track.Notes[i];
            var noteMidi = NormalizeMidi(PitchMath.TryNameToMidi(note.Pitch, out var m) ? m : 60);
            if (Math.Abs(note.Beat - beat) < 1e-6 && noteMidi == midi)
            {
                return true;
            }
        }
        return false;
    }

    private void DeleteNote(int index)
    {
        var track = _state.CurrentTrack;
        if (index < 0 || index >= track.Notes.Count)
        {
            return;
        }

        _state.SelectedNoteIds.Remove(track.Notes[index].Id);
        PushUndo();
        track.Notes.RemoveAt(index);
        _revision++;
    }

    private void SelectNotes(string[] ids)
    {
        _state.SelectedNoteIds.Clear();
        foreach (var id in ids)
        {
            if (Guid.TryParse(id, out var guid))
            {
                _state.SelectedNoteIds.Add(guid);
            }
        }
        _revision++;
    }

    private void ToggleNoteSelection(string id)
    {
        if (!Guid.TryParse(id, out var guid))
        {
            return;
        }
        if (!_state.SelectedNoteIds.Add(guid))
        {
            _state.SelectedNoteIds.Remove(guid);
        }
        _revision++;
    }

    private void SelectAllNotes()
    {
        _state.SelectedNoteIds.Clear();
        foreach (var note in _state.CurrentTrack.Notes)
        {
            _state.SelectedNoteIds.Add(note.Id);
        }
        _revision++;
    }

    private void ClearSelection()
    {
        if (_state.SelectedNoteIds.Count == 0)
        {
            return;
        }
        _state.SelectedNoteIds.Clear();
        _revision++;
    }

    private void BeginSelectionDrag()
    {
        _dragOriginals.Clear();
        foreach (var note in _state.CurrentTrack.Notes)
        {
            if (_state.SelectedNoteIds.Contains(note.Id))
            {
                _dragOriginals[note.Id] = (note.Beat, NoteMidi(note.Pitch));
            }
        }
    }

    private void UpdateSelectionDrag(SelectionDelta delta)
    {
        // Undo granularity: one snapshot per drag gesture, taken on the first move
        // that actually changes something (not per frame, and not for a plain click).
        var before = _dragSnapshotTaken ? null : _state.WorkingSong.DeepClone();
        if (!ApplySelectionDelta(delta, _dragOriginals) || _dragSnapshotTaken)
        {
            return;
        }
        PushUndoSnapshot(before!);
        _dragSnapshotTaken = true;
    }

    private void EndSelectionDrag()
    {
        _dragOriginals.Clear();
        _dragSnapshotTaken = false;
    }

    private void NudgeSelection(SelectionDelta delta)
    {
        var originals = new Dictionary<Guid, (double Beat, int Midi)>();
        foreach (var note in _state.CurrentTrack.Notes)
        {
            if (_state.SelectedNoteIds.Contains(note.Id))
            {
                originals[note.Id] = (note.Beat, NoteMidi(note.Pitch));
            }
        }
        if (originals.Count == 0)
        {
            return;
        }

        var before = _state.WorkingSong.DeepClone();
        if (ApplySelectionDelta(delta, originals))
        {
            PushUndoSnapshot(before);
        }
    }

    /// <summary>
    /// Moves every note in <paramref name="originals"/> by the delta. If any note would
    /// land on an unselected note (same beat + pitch, same track) the whole move is
    /// refused and false is returned, so the notes stay where they were.
    /// </summary>
    private bool ApplySelectionDelta(
        SelectionDelta delta, IReadOnlyDictionary<Guid, (double Beat, int Midi)> originals)
    {
        if (originals.Count == 0)
        {
            return false;
        }

        var track = _state.CurrentTrack;
        var step = _state.SnapBeats;

        var blocked = new HashSet<(long Step, int Midi)>();
        foreach (var note in track.Notes)
        {
            if (!originals.ContainsKey(note.Id))
            {
                blocked.Add((StepIndex(note.Beat, step), NoteMidi(note.Pitch)));
            }
        }

        var moves = new List<(Guid Id, double Beat, int Midi)>();
        foreach (var note in track.Notes)
        {
            if (!originals.TryGetValue(note.Id, out var origin))
            {
                continue;
            }
            var beat = Math.Max(0, origin.Beat + delta.BeatSteps * step);
            var midi = Math.Clamp(
                origin.Midi + delta.RowSteps,
                InstrumentLayout.PitchMinMidi,
                InstrumentLayout.PitchMaxMidi);

            if (blocked.Contains((StepIndex(beat, step), midi)))
            {
                return false; // collision with an unselected note: refuse the whole move
            }
            moves.Add((note.Id, beat, midi));
        }

        foreach (var (id, beat, midi) in moves)
        {
            var index = track.Notes.FindIndex(n => n.Id == id);
            if (index >= 0)
            {
                track.Notes[index] = track.Notes[index] with
                {
                    Beat = beat,
                    Pitch = PitchMath.MidiToName(midi),
                };
            }
        }
        _revision++;
        return true;
    }

    // --- undo / redo ---------------------------------------------------------

    private void PushUndo() => PushUndoSnapshot(_state.WorkingSong.DeepClone());

    private void PushUndoSnapshot(Song before)
    {
        _undo.Add(before);
        if (_undo.Count > UndoLimit)
        {
            _undo.RemoveAt(0);
        }
        _redo.Clear();
    }

    private void Undo()
    {
        if (_undo.Count == 0)
        {
            return;
        }
        _redo.Add(_state.WorkingSong.DeepClone());
        var snapshot = _undo[^1];
        _undo.RemoveAt(_undo.Count - 1);
        RestoreSnapshot(snapshot);
    }

    private void Redo()
    {
        if (_redo.Count == 0)
        {
            return;
        }
        _undo.Add(_state.WorkingSong.DeepClone());
        var snapshot = _redo[^1];
        _redo.RemoveAt(_redo.Count - 1);
        RestoreSnapshot(snapshot);
    }

    private void RestoreSnapshot(Song snapshot)
    {
        _state.WorkingSong = snapshot.DeepClone();
        _state.SelectedNoteIds.Clear();
        _dragOriginals.Clear();
        _dragSnapshotTaken = false;
        _resizeSnapshotTaken = false;
        _revision++;
    }

    // --- copy / paste --------------------------------------------------------

    private void CopySelection()
    {
        var track = _state.CurrentTrack;
        var selected = track.Notes
            .Where(n => _state.SelectedNoteIds.Contains(n.Id))
            .OrderBy(n => n.Beat)
            .ToList();

        _clipboard.Clear();
        if (selected.Count == 0)
        {
            _status = "";
            return;
        }

        // Clipboard beats are relative to the earliest note, which becomes beat 0.
        // The earliest note's absolute beat is the fixed reference for staircase paste.
        _clipboardRefBeat = selected[0].Beat;
        _pasteCount = 0;
        foreach (var note in selected)
        {
            _clipboard.Add(note with { Beat = note.Beat - _clipboardRefBeat, Id = Guid.NewGuid() });
        }

        _status = $"Copied {_clipboard.Count} note(s) — Ctrl+V to paste (staircase)";
    }

    private void CutSelection()
    {
        CopySelection();
        if (_clipboard.Count == 0)
        {
            return;
        }

        PushUndo();
        var track = _state.CurrentTrack;
        track.Notes.RemoveAll(n => _state.SelectedNoteIds.Contains(n.Id));
        _state.SelectedNoteIds.Clear();
        _status = $"Cut {_clipboard.Count} note(s) — Ctrl+V to paste (staircase)";
        _revision++;
    }

    private void PasteClipboard()
    {
        if (_clipboard.Count == 0)
        {
            return;
        }

        var track = _state.CurrentTrack;
        var step = _state.SnapBeats;

        // Staircase: each paste steps one snap right and two semitones down from the
        // clipboard's fixed reference point. Never rebased on the current selection.
        _pasteCount++;
        var beatOffset = _pasteCount * step;

        // Pitch shift is 2 semitones down per step, but once any clipboard note would
        // drop below the visible range we stop shifting pitch (beats keep stepping).
        var lowestMidi = _clipboard.Min(n => NoteMidi(n.Pitch));
        var semitoneOffset = -_pasteCount * 2;
        if (lowestMidi + semitoneOffset < InstrumentLayout.PitchMinMidi)
        {
            semitoneOffset = 0;
        }

        var occupied = new HashSet<(long Step, int Midi)>();
        foreach (var note in track.Notes)
        {
            occupied.Add((StepIndex(note.Beat, step), NoteMidi(note.Pitch)));
        }

        // Plan first; colliding notes are skipped individually (not all-or-nothing).
        var plan = new List<(Guid Id, double Beat, int Midi, double Velocity, double Duration)>();
        var skipped = 0;
        foreach (var note in _clipboard)
        {
            var beat = Math.Max(0, _clipboardRefBeat + note.Beat + beatOffset);
            beat = Math.Max(0, Math.Round(beat / step) * step);
            var midi = Math.Clamp(
                NoteMidi(note.Pitch) + semitoneOffset,
                InstrumentLayout.PitchMinMidi,
                InstrumentLayout.PitchMaxMidi);

            var key = (StepIndex(beat, step), midi);
            if (occupied.Contains(key))
            {
                skipped++;
                continue;
            }
            occupied.Add(key);
            plan.Add((Guid.NewGuid(), beat, midi, note.Velocity, note.Duration));
        }

        if (skipped > 0)
        {
            Console.WriteLine($"[riffgame] paste skipped {skipped} collision(s)");
        }
        if (plan.Count == 0)
        {
            return;
        }

        PushUndo();
        foreach (var (id, beat, midi, velocity, duration) in plan)
        {
            track.Notes.Add(new Note
            {
                Id = id,
                Beat = beat,
                Pitch = PitchMath.MidiToName(midi),
                Velocity = velocity,
                Duration = duration,
            });
        }

        _state.SelectedNoteIds.Clear();
        foreach (var (id, _, _, _, _) in plan)
        {
            _state.SelectedNoteIds.Add(id);
        }

        var firstBeat = plan.Min(p => p.Beat);
        _status = $"Pasted {plan.Count} note(s) at beat {firstBeat:0.##}"
            + (skipped > 0 ? $" ({skipped} skipped)" : "");
        _revision++;
    }

    // --- duration resize -----------------------------------------------------

    private void ResizeNote(NoteResize resize)
    {
        var track = _state.CurrentTrack;
        if (resize.Index < 0 || resize.Index >= track.Notes.Count)
        {
            return;
        }

        var step = _state.SnapBeats;
        var duration = Math.Max(step, Math.Round(resize.DurationBeats / step) * step);
        var note = track.Notes[resize.Index];
        if (Math.Abs(note.Duration - duration) < 1e-9)
        {
            return;
        }

        // One snapshot per resize gesture (taken on the first actual change).
        if (!_resizeSnapshotTaken)
        {
            PushUndo();
            _resizeSnapshotTaken = true;
        }

        track.Notes[resize.Index] = note with { Duration = duration };
        _revision++;
    }

    private void ResizeNoteEnd() => _resizeSnapshotTaken = false;

    private void ResizeSelectedNote(int steps)
    {
        if (_state.SelectedNoteIds.Count != 1)
        {
            return;
        }

        var track = _state.CurrentTrack;
        var id = _state.SelectedNoteIds.First();
        var index = track.Notes.FindIndex(n => n.Id == id);
        if (index < 0)
        {
            return;
        }

        var step = _state.SnapBeats;
        var duration = Math.Max(step, track.Notes[index].Duration + steps * step);
        if (Math.Abs(track.Notes[index].Duration - duration) < 1e-9)
        {
            return;
        }

        PushUndo();
        track.Notes[index] = track.Notes[index] with { Duration = duration };
        _revision++;
    }

    // --- delete selection / transport / audition -----------------------------

    private void DeleteSelectedNotes()
    {
        if (_state.SelectedNoteIds.Count == 0)
        {
            return;
        }

        PushUndo();
        var track = _state.CurrentTrack;
        track.Notes.RemoveAll(n => _state.SelectedNoteIds.Contains(n.Id));
        _state.SelectedNoteIds.Clear();
        _revision++;
    }

    private async Task TogglePlay()
    {
        if (_state.IsPlaying)
        {
            await PauseAsync();
            return;
        }
        // Start from the beginning of the song.
        _state.CurrentBeat = 0;
        await PlayAsync();
    }

    private async Task AuditionStart(int midi)
    {
        await _audio.InitAsync();
        await _audio.StartNoteAsync(
            _state.SelectedInstrument, PitchMath.MidiToName(NormalizeMidi(midi)));
    }

    private async Task AuditionStop(int midi)
    {
        await _audio.StopNoteAsync(
            _state.SelectedInstrument, PitchMath.MidiToName(NormalizeMidi(midi)));
    }

    /// <summary>Last note end in seconds plus a one-second grace period, for auto-reset.</summary>
    private double EndTimeSeconds()
    {
        var max = 0.0;
        var any = false;
        foreach (var track in _state.WorkingSong.Tracks)
        {
            foreach (var note in track.Notes)
            {
                any = true;
                var end = TimingService.BeatsToSeconds(note.Beat + note.Duration, _state.Bpm);
                if (end > max)
                {
                    max = end;
                }
            }
        }
        return any ? max + 1.0 : double.PositiveInfinity;
    }

    private static long StepIndex(double beat, double step) => (long)Math.Round(beat / step);

    private static int NoteMidi(string pitch) =>
        NormalizeMidi(PitchMath.TryNameToMidi(pitch, out var m) ? m : 60);

    private async Task PlayAsync()
    {
        _error = "";
        await _audio.InitAsync();
        _player = new SongPlayer(_audio, _state.WorkingSong);
        await _player.StartAsync();
        _state.IsPlaying = true;
        _playTimer!.Start();
    }

    private async Task PauseAsync()
    {
        _playTimer!.Stop();
        if (_player is not null)
        {
            await _player.PauseAsync();
        }
        _state.IsPlaying = false;
    }

    private async Task StopAsync()
    {
        _playTimer!.Stop();
        if (_player is not null)
        {
            await _player.StopAsync();
        }
        else
        {
            await _audio.ClearScheduledAsync();
            await _audio.StopTransportAsync();
        }

        await _audio.SeekTransportAsync(0);
        _state.CurrentBeat = 0;
        _state.IsPlaying = false;
    }

    private async Task PollAsync()
    {
        try
        {
            await InvokeAsync(async () =>
            {
                if (!_state.IsPlaying)
                {
                    return;
                }
                var seconds = await _audio.GetTransportTimeSecAsync();

                // Auto-stop one second after the last note ends, then reset to 0.
                if (seconds >= EndTimeSeconds())
                {
                    await StopAsync();
                    StateHasChanged();
                    return;
                }

                _state.CurrentBeat = TimingService.SecondsToBeats(seconds, _state.Bpm);
                StateHasChanged();
            });
        }
        catch (JSException)
        {
            // Audio module not ready; ignore until next tick.
        }
    }

    private async Task SaveAsync()
    {
        try
        {
            var json = await SongSerializer.ToJsonStringAsync(_state.WorkingSong);
            await _downloader.DownloadTextAsync($"{SafeTitle()}.riff.json", json);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task LoadAsync(InputFileChangeEventArgs e)
    {
        _error = "";
        try
        {
            await using var stream = e.File.OpenReadStream(maxAllowedSize: 16 * 1024 * 1024);
            var song = await SongSerializer.LoadAsync(stream);

            if (_state.IsPlaying || _player is not null)
            {
                await StopAsync();
            }

            _state.LoadSong(song);
            // Loading is not undoable: reset history and transient state.
            _undo.Clear();
            _redo.Clear();
            _dragOriginals.Clear();
            _clipboard.Clear();
            _pasteCount = 0;
            _status = "";
            _dragSnapshotTaken = false;
            _resizeSnapshotTaken = false;
            _revision++;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private string SafeTitle()
    {
        var title = _state.WorkingSong.Title;
        if (string.IsNullOrWhiteSpace(title))
        {
            return "song";
        }
        var cleaned = new string(title.Select(c => char.IsLetterOrDigit(c) ? c : '-').ToArray()).Trim('-');
        return cleaned.Length == 0 ? "song" : cleaned;
    }

    private void AdjustTimeZoom(int direction) =>
        _state.TimeZoom = ZoomLevels.StepBy(_state.TimeZoom, direction);

    private void AdjustPitchZoom(int direction) =>
        _state.PitchZoom = ZoomLevels.StepBy(_state.PitchZoom, direction);

    private void ApplyZoomChange(ZoomChange change)
    {
        _state.TimeZoom = ZoomLevels.Clamp(change.Time);
        _state.PitchZoom = ZoomLevels.Clamp(change.Pitch);
    }

    private static string Format(double seconds)
    {
        var total = (int)Math.Max(0, seconds);
        return $"{total / 60:00}:{total % 60:00}";
    }

    public async ValueTask DisposeAsync()
    {
        _playTimer?.Dispose();
        await _audio.DisposeAsync();
        await _downloader.DisposeAsync();
    }
}
